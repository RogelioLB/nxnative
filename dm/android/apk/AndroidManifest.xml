<?xml version="1.0" encoding="utf-8"?>
<!-- nxnative for Android: a launcher of the games on the phone and a NativeActivity that runs one. lib/arm64-v8a/ holds a host per game, libdmhost_<title ID>.so
     (dm/android/front_android.c), and libnxloader.so (dm/android/loader.c), which starts the one the launcher picked; the launcher, the touch controls and the text box
     are in classes.dex (dm/android/java) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.nxnative.android" android:versionCode="1" android:versionName="0.1">
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true"/>
    <uses-feature android:glEsVersion="0x00030000"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <application android:label="nxnative" android:hasCode="true" android:extractNativeLibs="true"
        android:appCategory="game" android:isGame="true" android:resizeableActivity="false">
        <!-- simpleperf from adb shell (CPU profiles of the replay on the phone); no cost at run time -->
        <profileable android:shell="true"/>
        <!-- the game, in a process of its own: a host is loaded once per process, so every launch (another game too) is a fresh one -->
        <!-- in a task of its own (taskAffinity): Launcher.endGame removes it whole, so the next game starts from its own intent, not the record of the one closed -->
        <activity android:name="android.app.NativeActivity" android:exported="false" android:launchMode="singleTask" android:process=":game" android:taskAffinity="org.nxnative.android.game"
            android:screenOrientation="sensorLandscape" android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="nxloader"/>
        </activity>
        <!-- the launcher (dm/android/java Launcher.java): the app's entry, the games on the phone, then a game's settings; Play starts the NativeActivity -->
        <activity android:name="org.nxnative.android.Launcher" android:exported="true"
            android:screenOrientation="sensorLandscape" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
